/* Managed by linuxcncsetup. */

@define-color bg           #1e1e2e;
@define-color bg-alt       #313244;
@define-color fg           #cdd6f4;
@define-color fg-muted     #a6adc8;
@define-color accent       #89b4fa;
@define-color warning      #f9e2af;
@define-color critical     #f38ba8;

* {
    border: none;
    border-radius: 0;
    font-family: "Sans", "Font Awesome 5 Free";
    font-size: 13px;
    min-height: 0;
}

window#waybar {
    background-color: @bg;
    color: @fg;
}

#workspaces button {
    padding: 0 10px;
    background-color: transparent;
    color: @fg-muted;
}

#workspaces button.focused {
    background-color: @bg-alt;
    color: @accent;
    border-bottom: 2px solid @accent;
}

#workspaces button.urgent {
    background-color: @critical;
    color: @bg;
}

#mode {
    background-color: @bg-alt;
    color: @warning;
    padding: 0 10px;
}

#window {
    color: @fg-muted;
}

#tray,
#pulseaudio,
#network,
#cpu,
#memory,
#clock {
    padding: 0 10px;
    color: @fg;
}

#clock {
    color: @accent;
}

#pulseaudio.muted {
    color: @fg-muted;
}

#network.disconnected {
    color: @critical;
}

#tray menu {
    background-color: @bg-alt;
    color: @fg;
}
