# Keep this file root-owned and mode 0600 at
# /etc/websetupmanager/websetupmanager.env.
WEB_SETUP_MANAGER_LIBRARY_DIR=/home/user/.local/share/websetupmanager/library
WEB_SETUP_MANAGER_STATE_DIR=/home/user/.local/state/websetupmanager
WEB_SETUP_MANAGER_PROGRAM_ROOT=/home/user/linuxcnc/nc_files
WEB_SETUP_MANAGER_LINUXCNC_INI=/home/user/linuxcnc/configs/corvuscnc/g540.ini
WEB_SETUP_MANAGER_PROGRAM_ROOT_DISPLAY=~/linuxcnc/nc_files
WEB_SETUP_MANAGER_LIBRARY_ALIAS=Программы LinuxCNC
WEB_SETUP_MANAGER_GCODE_EXTENSIONS=.ngc,.nc,.tap

WEB_SETUP_MANAGER_LISTEN_ADDRESS=10.0.1.136:443
WEB_SETUP_MANAGER_REMOTE_ACCESS=true
WEB_SETUP_MANAGER_ALLOWED_USER=user
WEB_SETUP_MANAGER_PAM_SERVICE=websetupmanager
WEB_SETUP_MANAGER_TLS_CERT_FILE=/etc/websetupmanager/tls/microb.int.crt
WEB_SETUP_MANAGER_TLS_KEY_FILE=/etc/websetupmanager/tls/microb.int.key

# Set explicit bounded upload limits for production (integer byte counts).
# Zero would mean unlimited and is not advised.
WEB_SETUP_MANAGER_ARTIFACT_UPLOAD_LIMIT=1073741824
WEB_SETUP_MANAGER_IMPORT_TOTAL_LIMIT=2147483648
