[Unit]
Description=Web Setup Manager
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/home/user/.local/share/websetupmanager/library /home/user/.local/state/websetupmanager /home/user/linuxcnc/nc_files

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user
EnvironmentFile=/etc/websetupmanager/websetupmanager.env
Environment=HOME=/home/user
Environment=USER=user
Environment=LOGNAME=user
ExecStart=/opt/websetupmanager/current/bin/websetupmanager
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0027
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ReadOnlyPaths=/etc/websetupmanager /home/user/linuxcnc/configs/corvuscnc/g540.ini
ReadWritePaths=/home/user/.local/share/websetupmanager/library /home/user/.local/state/websetupmanager /home/user/linuxcnc/nc_files

[Install]
WantedBy=multi-user.target
